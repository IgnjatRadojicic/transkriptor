# Kopiraj u .env i popuni. .env nikad ne ide na git.

# Claude: dobija se komandom "claude setup-token" (trosi tvoj Pro/Max plan, ne naplacuje se posebno)
CLAUDE_CODE_OAUTH_TOKEN=
# Model za beleske: sonnet (jeftinije) ili opus (bolje)
CLAUDE_MODEL=sonnet

# Hugging Face token (read), treba samo za prvo skidanje pyannote modela.
# Pre toga prihvati uslove na huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=
# 1 = WhisperX radi bez interneta. Modeli koji fale se ipak sami skinu pri prvom pokretanju.
HF_HUB_OFFLINE=1

# Samo za Docker: folder sa snimcima i folder gde se cuvaju modeli (~2 GB)
SNIMCI="./snimci"
MODELI="./modeli"

# Samo za WSL bez Dockera: gde su modeli (default ~/.cache/huggingface). Docker ovo ignorise.
# HF_HOME=/mnt/d/whisper-models
